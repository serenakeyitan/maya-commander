#!/usr/bin/env python3
"""maya — the local CLI that connects a machine's background coding agent to the Maya voice commander.

PATH B (the $0 / legal model): this CLI runs on the OWNER's machine and talks ONLY to the Maya cloud
over HTTP. It NEVER touches Anthropic credentials, never holds an API key, and is dependency-light
(stdlib urllib only) so it installs anywhere with zero friction. The owner's coding agent keeps
running on the owner's own Pro/Max subscription; Maya is just the remote voice layer.

🔴 IRON RULE (enforced here): never run an agent with ANTHROPIC_API_KEY set — that flips Claude Code
to API billing and breaks the "$0 / own subscription" premise. This CLI itself spawns no agent, but
it WARNS at `maya pair` if the key is set in the environment, and it scrubs the key from its own
process env defensively (so nothing it might ever spawn inherits it).

Subcommands:
  maya pair <code>            One-time: redeem the PIN-gated pairing code Maya gave you on the call.
                              Stores the machine token + your caller_id 0600 in ~/.maya/config.
  maya discuss "<brief>"      POST a thick brief → print the job_id and exit 0 in <5s (NON-BLOCKING,
                              the 600s-Bash-cap fix). Maya phones you; the Stop hook re-polls.
  maya discuss --poll <id>    ONE bounded poll (~60s). Prints the resolved instruction (exit 0) or a
                              PENDING sentinel (exit 0) — never a hang, never an error exit on pending.

Config:
  MAYA_CLOUD_URL   base URL of the Maya cloud (default https://maya-realtime.fly.dev).
  ~/.maya/config   JSON {token, owner_caller_id, cloud_url}, mode 0600, gitignored.
"""
from __future__ import annotations

import json
import os
import sys
import time
import urllib.error
import urllib.request

CONFIG_DIR = os.path.expanduser("~/.maya")
CONFIG_PATH = os.path.join(CONFIG_DIR, "config")
SESSIONS_DIR = os.path.join(CONFIG_DIR, "sessions")
DEFAULT_CLOUD_URL = "https://maya-realtime.fly.dev"

# Per-poll budget well under the 600s Bash hard cap (the audit's adjudicated ~60s, not 300s): each
# foreground `maya discuss --poll` stays far from the cliff; the Stop hook re-arms across turns.
POLL_BUDGET_SECONDS = 60
POLL_INTERVAL_SECONDS = 3
POST_TIMEOUT_SECONDS = 10


SEAM_LOG = os.path.join(CONFIG_DIR, "commander.log")


# --------------------------------------------------------------------------- env hygiene
def _scrub_api_key() -> None:
    """Defensively remove ANTHROPIC_API_KEY from this process env (Path B: subscription billing only)."""
    os.environ.pop("ANTHROPIC_API_KEY", None)


def _log_seam(seam: str, job_id: str = "", extra: str = "") -> None:
    """Append one client-side seam line to ~/.maya/commander.log for the M3 trigger-rate measurement.

    Seams: cli-posted (discuss created a job), cli-resolved (poll got the instruction), cli-pending
    (poll timed out, still discussing). The Stop hook logs hook-blocked. `maya trigger-rate` tallies
    these to compute the hook→skill→CLI→resolve funnel that gates the GO/NO-GO decision. Best-effort —
    never raises (logging must not break the CLI). No timestamp from a clock the tests can't control;
    we log a monotonic-free line and let the OS file mtime / line order carry ordering."""
    try:
        os.makedirs(CONFIG_DIR, mode=0o700, exist_ok=True)
        with open(SEAM_LOG, "a", encoding="utf-8") as fh:
            line = f"seam={seam} job_id={job_id or '-'}"
            if extra:
                line += f" {extra}"
            fh.write(line + "\n")
    except OSError:
        pass


# --------------------------------------------------------------------------- config io
def _load_config() -> dict:
    try:
        with open(CONFIG_PATH, encoding="utf-8") as fh:
            return json.load(fh)
    except (OSError, ValueError):
        return {}


def _atomic_write_0600(path: str, data: str) -> None:
    """Durably write `data` to `path` with 0600 perms, atomically: write a temp file in the same dir,
    fsync it, then os.replace (atomic rename) onto the target, then fsync the dir. A crash mid-write
    leaves EITHER the old file or the new one — never a truncated/empty file. (Fixes the token-delivery
    bug's amplifier: a non-atomic O_TRUNC write could leave a zero-byte config.json after a 'successful'
    200, so the machine thought it saved the token but didn't.)"""
    os.makedirs(os.path.dirname(path), mode=0o700, exist_ok=True)
    tmp = f"{path}.tmp.{os.getpid()}"
    fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
    try:
        with os.fdopen(fd, "w", encoding="utf-8") as fh:
            fh.write(data)
            fh.flush()
            os.fsync(fh.fileno())
        os.replace(tmp, path)  # atomic on POSIX
        try:
            dfd = os.open(os.path.dirname(path), os.O_DIRECTORY)
            try:
                os.fsync(dfd)
            finally:
                os.close(dfd)
        except OSError:
            pass  # dir fsync is best-effort (not all FS support it)
    finally:
        if os.path.exists(tmp):
            try:
                os.unlink(tmp)
            except OSError:
                pass


def _save_config(cfg: dict) -> None:
    _atomic_write_0600(CONFIG_PATH, json.dumps(cfg))


def _ack_pairing(base: str, secret: str) -> None:
    """Tell the server we've durably saved the token so it can consume the bound row (confirm-then-
    consume). Best-effort: if it fails, the row survives a grace window and a later poll re-delivers +
    re-acks, so a missed ack never loses the token — it just leaves the row to be reaped after grace."""
    try:
        _post(f"{base}/commander/pair/ack", {}, token=secret)
    except Exception:  # noqa: BLE001 — never fail the pairing on the ack; grace-TTL + re-poll cover it
        pass


def _finish_pairing(cfg: dict, base: str, secret: str, body: dict) -> int:
    """Shared success path for --poll and --wait: durably SAVE the token FIRST, then ACK the server (so
    it consumes the row), then clear connect_pending. Order matters: save-before-ack-before-clear means
    a crash at any point leaves a recoverable state (the secret + bound row both still exist until we've
    proven the token is on disk)."""
    cfg["token"] = body["token"]
    cfg["owner_caller_id"] = body.get("owner_caller_id", "")
    cfg["cloud_url"] = base
    _save_config(cfg)            # 1. durably persist the token (atomic)
    _ack_pairing(base, secret)   # 2. now safe to let the server consume the bound row
    _clear_connect_pending()     # 3. and drop the local pending record
    last4 = (cfg["owner_caller_id"] or "")[-4:]
    print(f"✓ Connected! This computer is now linked to your Maya account (…{last4}).")
    print("  Tip: when you're ready for Maya to auto-call on agent decisions, run `maya trigger-rate` then enable the hook.")
    return 0


def _cloud_url(cfg: dict) -> str:
    return (os.environ.get("MAYA_CLOUD_URL") or cfg.get("cloud_url") or DEFAULT_CLOUD_URL).rstrip("/")


# --------------------------------------------------------------------------- http
def _as_dict(raw: bytes) -> dict:
    """Decode a response body to a dict, coercing ANY non-object JSON (list/string/number from a CDN
    error page, proxy, or schema drift) to {} so every caller's body.get(...) is safe. A non-dict body
    that crashed body.get would break the advertised exit-0 poll contract the Stop hook relies on."""
    try:
        parsed = json.loads(raw.decode("utf-8") or "{}")
    except Exception:  # noqa: BLE001
        return {}
    return parsed if isinstance(parsed, dict) else {}


def _post(url: str, payload: dict, *, token: str | None = None, timeout: int = POST_TIMEOUT_SECONDS):
    data = json.dumps(payload).encode("utf-8")
    headers = {"Content-Type": "application/json"}
    if token:
        headers["Authorization"] = f"Bearer {token}"
    req = urllib.request.Request(url, data=data, headers=headers, method="POST")
    try:
        with urllib.request.urlopen(req, timeout=timeout) as resp:
            return resp.status, _as_dict(resp.read())
    except urllib.error.HTTPError as e:
        return e.code, _as_dict(e.read())
    except (urllib.error.URLError, TimeoutError, OSError) as e:
        return 0, {"error": f"network: {e}"}


def _get(url: str, *, token: str | None = None, timeout: int = POST_TIMEOUT_SECONDS):
    headers = {}
    if token:
        headers["Authorization"] = f"Bearer {token}"
    req = urllib.request.Request(url, headers=headers, method="GET")
    try:
        with urllib.request.urlopen(req, timeout=timeout) as resp:
            return resp.status, _as_dict(resp.read())
    except urllib.error.HTTPError as e:
        return e.code, _as_dict(e.read())
    except (urllib.error.URLError, TimeoutError, OSError) as e:
        return 0, {"error": f"network: {e}"}


# --------------------------------------------------------------------------- session id
def _session_id() -> str:
    """The originating session's stable id so the Stop hook can re-poll the right job across turns.

    Prefer the harness-exposed CLAUDE_SESSION_ID; else mint+persist our own UUID under ~/.maya/sessions
    keyed by cwd (the per-cwd lock file the phase-2 round-trip answerer will also key off).
    """
    env_id = (os.environ.get("CLAUDE_SESSION_ID") or "").strip()
    if env_id:
        return env_id
    os.makedirs(SESSIONS_DIR, mode=0o700, exist_ok=True)
    import hashlib

    cwd_key = hashlib.sha256(os.getcwd().encode("utf-8")).hexdigest()[:16]
    path = os.path.join(SESSIONS_DIR, cwd_key)
    try:
        with open(path, encoding="utf-8") as fh:
            return json.load(fh)["session_id"]
    except (OSError, ValueError, KeyError):
        import uuid

        sid = uuid.uuid4().hex
        with open(path, "w", encoding="utf-8") as fh:
            json.dump({"session_id": sid, "cwd": os.getcwd()}, fh)
        return sid


# --------------------------------------------------------------------------- pending-job state
# The Stop hook (commander/maya_stop_gate.py) reads ~/.maya/pending/<session_id> to know whether to
# re-arm a `maya discuss --poll` across turns (the 600s-cap survival). discuss writes it 'open' on
# POST; --poll clears it when the job reaches a terminal state. Keyed by the SAME session id the hook
# gets from Claude Code's stdin (CLAUDE_SESSION_ID, else the minted per-cwd id).
PENDING_DIR = os.path.join(CONFIG_DIR, "pending")


def _pending_path(session_id: str) -> str:
    safe = "".join(c for c in (session_id or "") if c.isalnum() or c in "-_")[:128]
    return os.path.join(PENDING_DIR, safe or "default")


# CLIENT-SIDE RE-ARM CEILING (defense in depth, M3 audit): even if the server-side queued/calling
# sweeps never run (scheduler stalled entirely), the loop must terminate. We stamp first_seen at POST
# and self-expire the pending record after this wall-clock — so a wedged server can't make the hook
# block forever. ~30 min matches the design's max re-poll wall-clock.
PENDING_MAX_AGE_SECONDS = 30 * 60


def _mark_pending(session_id: str, job_id: str) -> None:
    os.makedirs(PENDING_DIR, mode=0o700, exist_ok=True)
    with open(_pending_path(session_id), "w", encoding="utf-8") as fh:
        json.dump({"job_id": job_id, "status": "open", "first_seen": time.time()}, fh)


def _pending_expired(session_id: str) -> bool:
    """True if the pending record is older than the re-arm ceiling (→ the poll should give up + clear).
    Best-effort: a record without first_seen (legacy) or unreadable → treat as NOT expired (the server
    sweeps remain the primary terminator); only a real, old first_seen forces local expiry."""
    try:
        with open(_pending_path(session_id), encoding="utf-8") as fh:
            rec = json.load(fh)
        first = rec.get("first_seen")
        return isinstance(first, (int, float)) and (time.time() - first) > PENDING_MAX_AGE_SECONDS
    except (OSError, ValueError):
        return False


def _clear_pending(session_id: str) -> None:
    try:
        os.remove(_pending_path(session_id))
    except OSError:
        pass


# --------------------------------------------------------------------------- commands
def cmd_pair(args: list[str]) -> int:
    if not args:
        print("usage: maya pair <code>", file=sys.stderr)
        return 2
    code = args[0].strip()
    cfg = _load_config()
    if os.environ.get("ANTHROPIC_API_KEY"):
        print(
            "⚠️  ANTHROPIC_API_KEY is set in your environment. Path B requires your agent to bill via\n"
            "    your subscription, NOT the API. Unset it (remove from your shell profile) before\n"
            "    running coding agents, or commander runs will burn API credits.",
            file=sys.stderr,
        )
    url = _cloud_url(cfg) + "/commander/pair"
    status, body = _post(url, {"code": code})
    if status == 200 and body.get("token"):
        cfg["token"] = body["token"]
        cfg["owner_caller_id"] = body.get("owner_caller_id", "")
        cfg["cloud_url"] = _cloud_url(cfg)
        _save_config(cfg)
        print(f"✓ paired. machine bound to caller_id={cfg['owner_caller_id']}. config → {CONFIG_PATH}")
        return 0
    if status == 401:
        print("✗ invalid or expired pairing code. Ask Maya for a fresh one on the call.", file=sys.stderr)
    elif status == 404:
        print("✗ commander is not enabled on the server.", file=sys.stderr)
    elif status == 503:
        print("✗ server can't complete pairing (no machine token configured).", file=sys.stderr)
    else:
        print(f"✗ pairing failed (status={status}): {body.get('error', '')}", file=sys.stderr)
    return 1


def _require_paired(cfg: dict) -> tuple[str, str] | None:
    token = cfg.get("token")
    caller_id = cfg.get("owner_caller_id")
    if not token or not caller_id:
        print("✗ this machine isn't paired. Run `maya pair <code>` first.", file=sys.stderr)
        return None
    return token, caller_id


def cmd_discuss(args: list[str]) -> int:
    cfg = _load_config()
    paired = _require_paired(cfg)
    if paired is None:
        return 1
    token, caller_id = paired
    base = _cloud_url(cfg)

    # --poll <job_id>: ONE bounded poll, then exit 0 either way (the 600s-cap-safe re-arm shape).
    if args and args[0] == "--poll":
        if len(args) < 2:
            print("usage: maya discuss --poll <job_id>", file=sys.stderr)
            return 2
        job_id = args[1].strip()
        sid = _session_id()
        # CLIENT-SIDE CEILING (defense in depth): if this discussion has been pending past the wall-
        # clock ceiling, give up locally even if the server never terminalized it (scheduler fully
        # stalled). Clear pending so the Stop hook stops re-arming, and surface it honestly.
        if _pending_expired(sid):
            _clear_pending(sid)
            _log_seam("cli-expired", job_id)
            print("COMMANDER_EXPIRED: the discussion ran past the time limit; proceed using your own judgment.")
            return 0
        deadline = time.monotonic() + POLL_BUDGET_SECONDS
        while True:
            status, body = _get(f"{base}/commander/jobs/{job_id}", token=token)
            if status == 200 and body.get("terminal"):
                _clear_pending(sid)  # job is done → the Stop hook stops re-arming
                _log_seam("cli-resolved", job_id)
                # `or ''` guards an explicit JSON null (None.upper() / a null instruction would crash,
                # breaking the exit-0 contract). body is always a dict (coerced in _get).
                instr = body.get("resolved_instruction") or ""
                st = body.get("status") or ""
                if st == "resolved" and instr:
                    print(instr)  # the authoritative instruction → the agent reads this as its directive
                else:
                    # no_answer / expired / failed / canceled — surface honestly, no fabricated directive.
                    print(f"COMMANDER_{(st or 'unknown').upper()}: Maya could not reach you; proceed using your own judgment.")
                return 0
            if status == 404:
                _clear_pending(sid)  # no such job → don't keep re-arming on a dead id
                print("COMMANDER_UNKNOWN_JOB: no such job; proceed using your own judgment.", file=sys.stderr)
                return 0
            if time.monotonic() >= deadline:
                _log_seam("cli-pending", job_id)
                print(f"PENDING job_id={job_id} — still discussing. Re-poll next turn.")
                return 0  # exit 0 with a sentinel → the Stop hook re-arms; never an error exit
            time.sleep(POLL_INTERVAL_SECONDS)

    # default: POST a thick brief, print job_id, exit fast (NON-BLOCKING).
    brief = " ".join(args).strip()
    if not brief:
        print('usage: maya discuss "<brief>"   |   maya discuss --poll <job_id>', file=sys.stderr)
        return 2
    sid = _session_id()
    status, body = _post(
        f"{base}/commander/jobs",
        {"brief": brief, "owner_caller_id": caller_id, "session_id": sid},
        token=token,
    )
    if status == 202 and body.get("job_id"):
        _mark_pending(sid, body["job_id"])  # the Stop hook re-arms --poll across turns until resolved
        # session-id-source seam: 'env' = the harness exposed $CLAUDE_SESSION_ID (the hook's stdin id
        # will match → the loop re-arms); 'minted' = we had to mint a per-cwd id (it will NOT match the
        # hook's stdin id → the loop silently won't re-arm). trigger-rate reads this to distinguish
        # id-divergence from low model-compliance.
        _log_seam(
            "session-id-source", body["job_id"],
            extra=f"value={'env' if (os.environ.get('CLAUDE_SESSION_ID') or '').strip() else 'minted'}",
        )
        _log_seam("cli-posted", body["job_id"])
        print(f"job_id={body['job_id']} — Maya will call you. Poll with: maya discuss --poll {body['job_id']}")
        return 0
    if status == 401:
        print("✗ unauthorized — your pairing may have been revoked. Re-run `maya pair`.", file=sys.stderr)
    elif status == 404:
        print("✗ commander is not enabled on the server.", file=sys.stderr)
    else:
        print(f"✗ discuss failed (status={status}): {body.get('error', '')}", file=sys.stderr)
    return 1


def cmd_trigger_rate(args: list[str]) -> int:
    """Tally the local seam log into the hook→CLI→resolve funnel — the M3 GO/NO-GO measurement.

    Reads ~/.maya/commander.log (appended by the hook + CLI). The hook logs hook-blocked on EVERY
    re-arm turn for the same job, so the raw count over-counts; we DEDUPE hook-blocked by job_id so the
    denominator is "distinct discussions the hook nudged", making the rates meaningful (and never >100%):
      * posted-rate   = cli-posted / DISTINCT(hook-blocked job_ids)  — did the model run `maya discuss`
        for the jobs the hook nudged. (A model-compliance signal — but read with the session-id caveat.)
      * resolved-rate = cli-resolved / cli-posted — did posted jobs reach a decision.
    The session-id-source tally surfaces the silent-divergence failure mode: if many discusses used a
    'minted' id (no $CLAUDE_SESSION_ID), a low posted-rate is an ID-PLUMBING problem, not low compliance.
    """
    counts = {"hook-blocked": 0, "cli-posted": 0, "cli-resolved": 0, "cli-pending": 0, "cli-expired": 0}
    blocked_jobs: set[str] = set()
    id_source = {"env": 0, "minted": 0}
    try:
        with open(SEAM_LOG, encoding="utf-8") as fh:
            for line in fh:
                parts = dict(
                    p.split("=", 1) for p in line.split() if "=" in p
                )
                seam = parts.get("seam", "")
                if seam in counts:
                    counts[seam] += 1
                if seam == "hook-blocked":
                    blocked_jobs.add(parts.get("job_id", ""))
                if seam == "session-id-source":
                    val = parts.get("value", "")
                    if val in id_source:
                        id_source[val] += 1
    except OSError:
        print("no seam log yet (~/.maya/commander.log). Run some discussions first.", file=sys.stderr)
        return 1

    distinct_blocked = len(blocked_jobs - {""})

    def _rate(num, den):
        return f"{(100 * num / den):.0f}%" if den else "n/a"

    print("commander trigger-rate (from ~/.maya/commander.log):")
    for k, v in counts.items():
        print(f"  {k:16} {v}")
    print(f"  distinct-blocked {distinct_blocked}  (hook-blocked deduped by job_id)")
    print(f"  posted-rate      {_rate(counts['cli-posted'], distinct_blocked)}  (cli-posted / distinct hook-blocked jobs)")
    print(f"  resolved-rate    {_rate(counts['cli-resolved'], counts['cli-posted'])}  (cli-resolved / cli-posted)")
    if id_source["env"] or id_source["minted"]:
        print(f"  session-id-source  env={id_source['env']} minted={id_source['minted']}  "
              f"(if minted>0, $CLAUDE_SESSION_ID isn't reaching the CLI → the hook can't match; a low "
              f"posted-rate may be id-divergence, not compliance)")
    return 0


def _machine_label() -> str:
    import socket

    try:
        host = socket.gethostname()
    except Exception:  # noqa: BLE001
        host = "this-computer"
    return f"{host}:{os.getcwd()}"[:200]


CONNECT_POLL_BUDGET = 90      # one bounded poll, < the 600s Bash cap (mirrors discuss)
CONNECT_POLL_INTERVAL = 3
CONNECT_PENDING_PATH = os.path.join(CONFIG_DIR, "connect_pending")  # {pending_secret, code, expires_mono}


def _save_connect_pending(rec: dict) -> None:
    _atomic_write_0600(CONNECT_PENDING_PATH, json.dumps(rec))  # atomic: never a torn pending file


def _load_connect_pending() -> dict:
    try:
        with open(CONNECT_PENDING_PATH, encoding="utf-8") as fh:
            return json.load(fh)
    except (OSError, ValueError):
        return {}


def _clear_connect_pending() -> None:
    try:
        os.remove(CONNECT_PENDING_PATH)
    except OSError:
        pass


def cmd_connect(args: list[str]) -> int:
    """Connect this computer to Maya. `maya connect` mints a 6-digit code (shown here); you CALL Maya,
    pass your PIN, and READ HER the six digits. `maya connect --wait` mints the code AND blocks until
    the bind lands, so you never type a second command (this is what install.sh runs). `maya connect
    --poll` does ONE bounded poll (for the /maya-connect skill to re-arm across turns)."""
    cfg = _load_config()
    base = _cloud_url(cfg)
    if os.environ.get("ANTHROPIC_API_KEY"):
        print(
            "⚠️  ANTHROPIC_API_KEY is set — unset it so your agent bills via your subscription, not the API.",
            file=sys.stderr,
        )

    # --poll: one bounded poll, authenticated by the 128-bit pending_secret (NEVER the 6 digits).
    if args and args[0] == "--poll":
        rec = _load_connect_pending()
        secret = rec.get("pending_secret")
        if not secret:
            print("Nothing to connect — run `maya connect` first.", file=sys.stderr)
            return 2
        deadline = time.monotonic() + CONNECT_POLL_BUDGET
        while True:
            status, body = _get(f"{base}/commander/pair/status", token=secret)
            st = body.get("status") if status == 200 else None
            if status == 200 and st == "bound" and body.get("token"):
                return _finish_pairing(cfg, base, secret, body)  # save → ack → clear (idempotent)
            if status == 200 and st == "burned":
                _clear_connect_pending()  # terminal: the SERVER said burned → safe to drop the secret
                print("✗ Too many wrong reads — that code is burned. Run `maya connect` again for a fresh code.", file=sys.stderr)
                return 1
            if status == 404:
                print("✗ commander is not enabled on the server.", file=sys.stderr)
                return 1
            if status == 401:
                # 401 = the server doesn't recognize this secret. With confirm-then-consume the bound
                # row survives until WE ack it, so a 401 here usually means the row was reaped after the
                # grace window (we waited too long) — NOT that the token was silently lost. Do NOT
                # discard the pending file blindly; tell the user to re-mint. (The audit's phantom-
                # pairing amplifier was clearing the still-valid secret on a transient 401.)
                _clear_connect_pending()
                print("✗ This pairing is no longer active. Run `maya connect` again for a fresh code.", file=sys.stderr)
                return 1
            if time.monotonic() >= deadline:
                code = rec.get("code", "??????")
                print(f"PENDING — still waiting. Call Maya and read her: {_grouped(code)}  (re-poll continues)")
                return 0  # exit 0 → the skill re-arms; never an error exit
            time.sleep(CONNECT_POLL_INTERVAL)

    # default: mint a code + show it + the call instructions.
    # --wait: after minting, BLOCK and poll in-process until the bind lands (or the code expires), so
    # the user never types a SECOND command. This is what install.sh runs at the end of the
    # "easiest install" flow: one fuzzy sentence → agent runs install.sh → code prints → the SAME
    # process waits → the moment the user reads the digits to Maya, it prints "Connected!". The plain
    # `maya connect` (no --wait) stays non-blocking for the skill-driven path.
    wait_mode = bool(args and args[0] == "--wait")
    status, body = _post(f"{base}/commander/connect", {"machine_label": _machine_label()})
    if status == 202 and body.get("pending_secret"):
        code = body.get("code", "")
        secret = body["pending_secret"]
        _save_connect_pending({"pending_secret": secret, "code": code})
        num = body.get("maya_number") or ""
        # ASR-FREE pairing: ARM this row over HTTP so Maya can read the FINGERPRINT back for a yes/no.
        # (No more reading 6 digits aloud — voice mis-heard them.) The fingerprint is what's shown big.
        astat, abody = _post(f"{base}/commander/pair/arm", {}, token=secret)
        fp = (abody.get("fingerprint") if astat == 200 else "") or body.get("fingerprint") or ""
        print("\n  ┌─ Connect this computer to Maya ─────────────────────────")
        print(f"  │  Fingerprint:  {fp}")
        print(f"  │  Call Maya{(' at ' + num) if num else ''} and say \"connect my computer.\"")
        print(f"  │  She'll read back this fingerprint — say YES if it matches.")
        if num:
            print(f"  │  (tap to call: tel:{num})")
        print("  │  This computer:  " + _machine_label())
        print("  └─────────────────────────────────────────────────────────\n")
        if not wait_mode:
            print("Then run:  maya connect --poll   (or the /maya-connect skill keeps polling until you're linked)")
            return 0
        # --wait: poll in-process until bound/expired. Long budget here (the human has to dial + talk),
        # so this is NOT CONNECT_POLL_BUDGET (the short skill budget) — give them a few minutes.
        print("Waiting for you to confirm the fingerprint with Maya… (this window will say so when you're linked)")
        ttl = body.get("ttl") or 180
        deadline = time.monotonic() + min(int(ttl) + 30, 600)
        try:
            _last_arm = time.monotonic()
            while True:
                status, pbody = _get(f"{base}/commander/pair/status", token=secret)
                st = pbody.get("status") if status == 200 else None
                if status == 200 and st == "bound" and pbody.get("token"):
                    rc = _finish_pairing(cfg, base, secret, pbody)  # save → ack → clear (idempotent)
                    return rc
                if status == 404:
                    print("\n✗ commander is not enabled on the server.", file=sys.stderr)
                    return 1
                if status == 401:
                    _clear_connect_pending()
                    print("\n✗ That pairing is no longer active. Just run `maya connect --wait` again for a fresh one.", file=sys.stderr)
                    return 1
                if time.monotonic() >= deadline:
                    print(f"\nStill waiting — the pairing may have expired. Run `maya connect --wait` again for a fresh one (fingerprint {fp}).")
                    return 0  # exit 0: not an error, the user can just re-run
                # Keep the row ARMED through a long call: the server auto-reverts armed→pending after a
                # short TTL, so re-arm periodically while we wait (cheap; idempotent).
                if time.monotonic() - _last_arm > 45:
                    _post(f"{base}/commander/pair/arm", {}, token=secret)
                    _last_arm = time.monotonic()
                time.sleep(CONNECT_POLL_INTERVAL)
        except KeyboardInterrupt:
            # The user hit Ctrl-C (or hung up and closed the window). Don't dump a traceback — the
            # pending secret is still saved, so tell them how to resume with no data lost.
            print(f"\nStopped waiting. Fingerprint {fp} is still good for a bit — confirm it with Maya,")
            print("then run `maya connect --poll` to finish, or `maya connect --wait` to start fresh.")
            return 0
    if status == 429:
        print("✗ too many pending connects from here — wait a minute and try again.", file=sys.stderr)
    elif status == 404:
        print("✗ commander is not enabled on the server.", file=sys.stderr)
    else:
        print(f"✗ connect failed (status={status}): {body.get('error', '')}", file=sys.stderr)
    return 1


def _grouped(code: str) -> str:
    """Render a 6-digit code grouped for easy reading aloud: '429185' → '4 2 9  1 8 5'."""
    d = "".join(ch for ch in (code or "") if ch.isdigit())
    if len(d) == 6:
        return f"{d[0]} {d[1]} {d[2]}   {d[3]} {d[4]} {d[5]}"
    return code


USAGE = """maya — voice commander for your background coding agents

  maya connect                connect this computer to Maya (shows a 6-digit code to read her on a call)
  maya connect --poll         one bounded poll until this computer is linked
  maya discuss "<brief>"      start a voice discussion (non-blocking; prints a job_id)
  maya discuss --poll <id>    one bounded poll for the resolved instruction
  maya trigger-rate           tally the local seam log (the GO/NO-GO measurement)
  maya pair <code>            [legacy] redeem a long pairing code (fallback; prefer `maya connect`)
"""


def main(argv: list[str]) -> int:
    _scrub_api_key()
    if not argv:
        print(USAGE)
        return 2
    cmd, rest = argv[0], argv[1:]
    if cmd == "connect":
        return cmd_connect(rest)
    if cmd == "pair":
        return cmd_pair(rest)
    if cmd == "discuss":
        return cmd_discuss(rest)
    if cmd == "trigger-rate":
        return cmd_trigger_rate(rest)
    if cmd in ("-h", "--help", "help"):
        print(USAGE)
        return 0
    print(f"unknown command: {cmd}\n\n{USAGE}", file=sys.stderr)
    return 2


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
